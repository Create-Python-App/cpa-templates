"""Unit tests for the Glue job's pure-Python transforms.

No Spark, Glue, or AWS runtime is required; ``glue_etl.transforms`` operates
on plain dictionaries so the suite runs anywhere with pytest.
"""

from datetime import UTC, datetime
from typing import Any

from glue_etl.transforms import (
    clean_batch,
    drop_records_missing_keys,
    normalize_record,
    with_ingestion_date,
)


def test_normalize_record_strips_strings_and_drops_none() -> None:
    assert normalize_record({"id": "  a1 ", "note": None, "count": 3}) == {
        "id": "a1",
        "count": 3,
    }


def test_drop_records_missing_keys() -> None:
    records: list[dict[str, Any]] = [{"id": "a"}, {"id": None}, {"other": "x"}]
    assert drop_records_missing_keys(records, ["id"]) == [{"id": "a"}]


def test_with_ingestion_date_uses_fixed_moment() -> None:
    moment = datetime(2026, 3, 4, 5, 6, tzinfo=UTC)
    stamped = with_ingestion_date({"id": "a"}, moment)
    assert stamped == {"id": "a", "ingestion_date": "2026-03-04"}


def test_clean_batch_end_to_end() -> None:
    moment = datetime(2026, 3, 4, 5, 6, tzinfo=UTC)
    records: list[dict[str, Any]] = [
        {"id": "  a1 ", "city": "Lima"},
        {"id": None, "city": "Bogota"},
        {"city": "Santiago"},
    ]
    assert clean_batch(records, ["id"], moment) == [
        {"id": "a1", "city": "Lima", "ingestion_date": "2026-03-04"}
    ]


def test_config_defaults_match_scaffold_options() -> None:
    import os

    for key in (
        "JOB_NAME",
        "CATALOG_DATABASE",
        "S3_BUCKET_PREFIX",
        "GLUE_VERSION",
        "WORKER_TYPE",
        "DPU_NUMBER",
        "AWS_REGION",
    ):
        os.environ.pop(key, None)

    from glue_etl import config

    assert config.Settings().job_name == "{{ jobName }}"
    assert config.Settings().catalog_database == "{{ catalogDatabase }}"
