
# --- Rate Limiting (fastapi-rate-limit) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute

# WARNING: The default in-memory backend isolates state per-worker.
# If you run Uvicorn/Gunicorn with multiple workers, or multiple Kubernetes pods,
# you MUST use a Redis backend to ensure limits are enforced globally.
# RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
